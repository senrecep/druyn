---
import { t, type Locale } from "@/i18n";

/**
 * The cover drawing: the real demo project as a process diagram with
 * booked/planned hours as progress bars and dimension chains in red.
 * White line work on the blueprint; draws itself on load (see sheets.ts).
 */
interface Props {
  locale: Locale;
  class?: string;
}
const { locale, class: className = "" } = Astro.props;
const dict = t(locale);
const tasks = dict.demo.tasks;

const W = 244;
const H = 104;
const left = tasks.slice(0, 3).map((task, i) => ({ ...task, x: 20, y: 48 + i * 156 }));
const right = tasks.slice(3, 5).map((task, i) => ({ ...task, x: 356, y: 126 + i * 180 }));
const boxes = [...left, ...right];
const barW = 100;
const fmt = (n: number) => (Number.isInteger(n) ? String(n) : n.toFixed(2).replace(/0$/, ""));
const sumBooked = tasks.reduce((s, t) => s + t.booked, 0);
const sumPlanned = tasks.reduce((s, t) => s + t.planned, 0);
---

<figure class={className}>
  <svg
    data-draw
    viewBox="0 0 640 540"
    role="img"
    aria-label={`${dict.hero.drawingTitle}: ${dict.hero.drawingCaption}`}
    class="h-auto w-full"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="square"
    font-family="var(--font-mono)"
  >

    {
      boxes.map((b, i) => (
        <g>
          <clipPath id={`card-${i}`}>
            <rect x={b.x} y={b.y} width={W} height={H} rx="5" />
          </clipPath>
          <rect class="fill-in" x={b.x} y={b.y} width={W} height={H} rx="5" fill="#ffffff" stroke="none" />
          <rect class="fill-in" x={b.x} y={b.y} width={W} height="30" fill="#e2a6af" stroke="none" clip-path={`url(#card-${i})`} />
          <rect class="draw" x={b.x} y={b.y} width={W} height={H} rx="5" stroke="#c2beb9" />
          <text class="fill-in" x={b.x + 10} y={b.y + 20} font-size="12" fill="#1c1a19" stroke="none" font-weight="700">
            {b.name.length > 30 ? `${b.name.slice(0, 29)}…` : b.name}
          </text>
          <text class="fill-in" x={b.x + 10} y={b.y + 48} font-size="10.5" fill="#595450" stroke="none">
            {dict.plankopf.projectValue}
          </text>
          <rect class="draw" x={b.x + 10} y={b.y + 64} width={barW} height="18" rx="3" stroke="#c2beb9" />
          <rect class="fill-in" x={b.x + 10} y={b.y + 64} width={(b.booked / b.planned) * barW} height="18" rx="3" fill="#e2a6af" />
          <text class="fill-in" x={b.x + 16} y={b.y + 77} font-size="10" fill="#1c1a19" stroke="none">
            {b.role}
          </text>
          <text class="fill-in figure" x={b.x + W - 10} y={b.y + 77} font-size="12" fill="#1c1a19" stroke="none" text-anchor="end">
            {fmt(b.booked)}/{b.planned} {dict.demo.hours}
          </text>
          {b.booked >= b.planned && (
            <path class="draw" d={`M${b.x + W - 26} ${b.y + 43} l5 5 l10 -10`} stroke="#3cb371" stroke-width="2" />
          )}
        </g>
      ))
    }

    <!-- dependencies: three left tasks join a bus, then split to the two right tasks -->
    <path class="draw" d={`M${20 + W} ${48 + H / 2} H310`} />
    <path class="draw" d={`M${20 + W} ${48 + 156 + H / 2} H310`} />
    <path class="draw" d={`M${20 + W} ${48 + 312 + H / 2} H310`} />
    <path class="draw" d={`M310 ${48 + H / 2} V${48 + 312 + H / 2}`} />
    <path class="draw" d={`M310 ${126 + H / 2} H356`} />
    <path class="draw" d={`M310 ${306 + H / 2} H356`} />
    <path class="draw" d={`M348 ${126 + H / 2 - 5} l8 5 l-8 5`} />
    <path class="draw" d={`M348 ${306 + H / 2 - 5} l8 5 l-8 5`} />

    <!-- dimension chains in red: total hours across the first column, calendar weeks down the right -->
    <g class="text-[#ff6b7a]" stroke="currentColor">
      <path class="draw" d="M20 28 V18 M264 28 V18 M20 23 H264" />
      <text class="fill-in" x="142" y="14" font-size="12" fill="currentColor" stroke="none" text-anchor="middle">
        {fmt(sumBooked)}/{sumPlanned} {dict.demo.hours} {dict.demo.booked}
      </text>
      <path class="draw" d="M608 126 H620 M608 410 H620 M614 126 V410" />
      <text class="fill-in" transform="translate(632 268) rotate(90)" font-size="12" fill="currentColor" stroke="none" text-anchor="middle">
        {dict.demo.weeks}
      </text>
      <!-- today flag on the bus -->
      <path class="draw" d="M310 470 V525 M310 470 h26 l-6 8 l6 8 h-26" />
      <text class="fill-in" x="342" y="483" font-size="12" fill="currentColor" stroke="none">{dict.demo.today}</text>
    </g>
  </svg>
  <figcaption class="label mt-3 max-w-[30rem] opacity-85">{dict.hero.drawingTitle} · {dict.hero.drawingCaption}</figcaption>
</figure>
