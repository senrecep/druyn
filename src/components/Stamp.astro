---
/** The primary action, drawn as the approval stamp in dimension red. */
interface Props {
  href: string;
  class?: string;
  /** "fill" is the one primary action per sheet; "outline" for the secondary. */
  variant?: "fill" | "outline" | "outline-white";
  type?: "link" | "submit";
}
const { href, class: className = "", variant = "fill", type = "link" } = Astro.props;
const base =
  "stamp inline-flex min-h-14 items-center justify-center rounded px-7 font-mono text-[0.8125rem] font-bold tracking-[0.12em] uppercase transition-[transform,box-shadow,background-color] duration-200 ease-out motion-safe:hover:-translate-y-0.5 active:translate-y-0";
const styles = {
  fill: "bg-action text-ink shadow-[0_2px_5px_rgba(0,0,0,0.1)] hover:bg-action-pressed",
  outline: "border border-ink-soft text-ink hover:bg-ink hover:text-white",
  "outline-white": "border border-white/70 text-white hover:bg-white hover:text-blueprint",
}[variant];
---

{
  type === "submit" ? (
    <button type="submit" class:list={[base, styles, className]}>
      <slot />
    </button>
  ) : (
    <a href={href} class:list={[base, styles, className]}>
      <slot />
    </a>
  )
}

